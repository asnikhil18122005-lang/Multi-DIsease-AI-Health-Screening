# JWT Authentication Secret (for production, provide a strong secret)
JWT_SECRET=super_secret_clinical_portal_jwt_signing_key_change_in_production

# Persistent Database Filepath (defaults to .data/health_screening.db if unset)
DB_PATH=.data/health_screening.db
STORAGE_DIR=.data

# Directory containing the 10 trained .joblib disease model files
MODEL_PATH=models

# Deployed Multi-Disease AI Backend URL (Render)
MODEL_SERVICE_URL=https://multi-disease-backend-5gms.onrender.com
VITE_MULTI_DISEASE_BACKEND_URL=https://multi-disease-backend-5gms.onrender.com

# Supabase (optional / legacy migration)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
